# used bash in this script
SHELL := /bin/bash

# main config
# This bench project lives at tb/<ip>/. The repo (rtl/, lib/) is two levels up.
REPO_DIR           ?= ../..
RTL_FOLDER         ?= $(REPO_DIR)/rtl
LIB_FOLDER         ?= $(REPO_DIR)/lib
TB_FOLDER          ?= .
SIM_FOLDER         ?= ./sim
SCRIPT_FOLDER      ?= ./script

VIVADO := vivado -mode batch -source

ifdef MAKE_TERMOUT
	ESC:=$(shell printf '\033')
	GREEN:=$(ESC)[1;32m
	RED:=$(ESC)[1;31m
	HL:=$(ESC)[0;33m
	NC:=$(ESC)[0m
else
	GREEN:=
	RED:=
	HL:=
	NC:=
endif

# every tb/tb_*.sv is auto-discovered as a runnable testcase, minus any listed in
# script/skip.list (testcases that failed vtestgen's self-check). One name per
# line, '#' starts a comment. The .sv files are left in place, just not run.
SKIP_LIST           := $(if $(wildcard $(SCRIPT_FOLDER)/skip.list),$(shell sed 's/\#.*//' $(SCRIPT_FOLDER)/skip.list))
# match tb_*.sv only (not tb_*.svh probe includes or editor backups), then strip
# the dir and the .sv extension robustly via notdir/basename.
TESTCASE            := $(filter-out $(SKIP_LIST),$(notdir $(basename $(wildcard $(TB_FOLDER)/tb_*.sv))))
TB_DEPENDENCIES     += $(wildcard $(TB_FOLDER)/*.vh)
TB_DEPENDENCIES     += $(wildcard $(TB_FOLDER)/sti_*.sv)
TB_DEPENDENCIES     += $(wildcard $(TB_FOLDER)/sco_*.sv)
# precise RTL hierarchy filelist generated by vtestgen (defines RTL_FILES)
-include $(SCRIPT_FOLDER)/rtl.f

.PHONY: all rerun retest clean cleanf help report list $(TESTCASE)

all: $(TESTCASE)

# rerun : re-run only the testcases that did NOT pass last time (cleanf keeps PASS
#         sim dirs, so previously-passing tests are skipped). Use during iteration.
rerun: cleanf all

# retest: authoritative full re-run -- wipe ALL sim dirs (including prior PASS)
#         and run every testcase fresh. Use this after an RTL fix so a fix that
#         regresses a previously-passing testcase is actually caught.
retest: clean all

$(TESTCASE):
	@if test ! -f "$(SIM_FOLDER)/$@/simulate.log" ; then \
		mkdir -p $(SIM_FOLDER)/$@ ;\
		echo "Building $@ [$(HL)$(SIM_FOLDER)/$@/$(NC)] ..." ;\
		if test ! -f "$(SIM_FOLDER)/$@/Makefile" ; then \
			cp $(SCRIPT_FOLDER)/library.mk $(SIM_FOLDER)/$@/Makefile ;\
		fi ;\
		time $(MAKE) -C $(SIM_FOLDER)/$@ ;\
		echo "Finish $@ [$(HL)$(SIM_FOLDER)/$@/$(NC)] ..." ;\
	fi ;\

cleanf:
	@for si in $(TESTCASE) ; do \
		if test -f "$(SIM_FOLDER)/$$si/simulate.log" ; then \
			result=$$(grep -m1 FINISH $(SIM_FOLDER)/$$si/simulate.log | awk '{print $$2}') ;\
			if [ -z "$$result" ]; then \
				rm -rf $(SIM_FOLDER)/$$si ;\
			elif [ "$$result" != PASS ]; then \
				rm -rf $(SIM_FOLDER)/$$si ;\
			fi ;\
		else \
			rm -rf $(SIM_FOLDER)/$$si ;\
		fi ;\
	done ;\

report:
	@for si in $(TESTCASE) ; do \
		if test -f "$(SIM_FOLDER)/$$si/simulate.log" ; then \
			result=$$(grep -m1 FINISH $(SIM_FOLDER)/$$si/simulate.log | awk '{print $$2}') ;\
			if [ -z "$$result" ]; then \
				echo "$$(date -r $(SIM_FOLDER)/$$si/simulate.log +"[%F|%T]:") $(RED)FAIL$(NC) ...... $$si" ;\
			elif [ "$$result" = PASS ]; then \
				echo "$$(date -r $(SIM_FOLDER)/$$si/simulate.log +"[%F|%T]:") $(GREEN)PASS$(NC) ...... $$si" ;\
			else \
				echo "$$(date -r $(SIM_FOLDER)/$$si/simulate.log +"[%F|%T]:") $(RED)FAIL$(NC) ...... $$si" ;\
			fi ;\
		else \
			echo "$$(date +"[%F|%T]:")$(HL)NOT FINISH$(NC) ...... $$si" ;\
		fi ;\
	done ;\

clean:
	rm -rf $(SIM_FOLDER)/*

list:
	@echo $(TESTCASE) | tr " " "\n"

help:
	@echo ""
	@echo "To run all testcases       : make"
	@echo "To rerun failed testcases  : make rerun   (keeps prior PASS results)"
	@echo "To re-run the WHOLE suite  : make retest  (fresh; catches regressions)"
	@echo "To run one testcase        : make tb_<name>"
	@echo "To list all testcases      : make list"
	@echo "To report results          : make report"
	@echo ""

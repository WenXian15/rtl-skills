# used bash in this script
SHELL := /bin/bash

# main config
# This recipe runs from tb/<ip>/sim/<tc>/. ROOT_DIR is the bench root (tb/<ip>);
# the repo (rtl/, lib/) is two further levels up at REPO_DIR.
TIMEOUT            ?= 900
ROOT_DIR           ?= ../..
REPO_DIR           ?= $(ROOT_DIR)/../..
LIB_FOLDER         ?= $(REPO_DIR)/lib
RTL_FOLDER         ?= $(REPO_DIR)/rtl
TB_FOLDER          ?= $(ROOT_DIR)
SIM_FOLDER         ?= $(ROOT_DIR)/sim
SCRIPT_FOLDER      ?= $(ROOT_DIR)/script

VIVADO := vivado -mode batch -source

ifdef MAKE_TERMOUT
	ESC:=$(shell printf '\033')
	GREEN:=$(ESC)[1;32m
	RED:=$(ESC)[1;31m
	HL:=$(ESC)[0;33m
	NC:=$(ESC)[0m
else
	GREEN:=
	RED:=
	HL:=
	NC:=
endif

# run <logname>, <command> : run a command, tee to <logname>.log, print OK/FAILED
define run
@echo -n "run $(strip $(1)) [$(HL)$(CURDIR)/$(strip $(1)).log$(NC)] ..."
@$(strip $(2)) > $(strip $(1)).log 2>&1; \
(ERR=$$?; if [ $$ERR = 0 ]; then \
	echo " $(GREEN)OK$(NC)"; \
else \
	echo " $(RED)FAILED$(NC)"; \
	echo "For details see $(HL)$(CURDIR)/$(strip $(1)).log$(NC)"; \
	echo ""; \
fi; exit)
endef

# testcase name is derived from this sim sub-folder name (== tb/<TESTCASE>.sv)
TESTCASE            := $(shell pwd | tr "/" "\n" | tail -n 1)

TB_DEPENDENCIES     += $(wildcard $(TB_FOLDER)/*.vh)
STI_FILES           += $(wildcard $(TB_FOLDER)/sti_*.sv)
STI_FILES           += $(wildcard $(TB_FOLDER)/sco_*.sv)
# precise RTL hierarchy filelist generated by vtestgen (defines RTL_FILES using
# $(RTL_FOLDER)/$(LIB_FOLDER), so it is independent of this recipe's depth)
include $(SCRIPT_FOLDER)/rtl.f

.PHONY: all xilinx

all: xilinx

XILINX_DEPS += $(TB_DEPENDENCIES)
XILINX_DEPS += $(STI_FILES)
XILINX_DEPS += $(RTL_FILES)

# compile RTL (.v) as Verilog-2005 and the bench (.sv: sti/sco + testcase) as
# SystemVerilog in separate xvlog passes, rather than relying on extension
# auto-detect for one mixed call. This keeps the RTL/TB language split explicit
# (CodingStyle §0) and matches vfill's two-step compile. The two passes are
# grouped with { } so the run macro's redirection captures both into compile.log.
xilinx: $(XILINX_DEPS)
	$(call run, compile, { xvlog --incr --relax $(RTL_FILES) && xvlog --incr --relax -sv -i $(TB_FOLDER) $(STI_FILES) $(TB_FOLDER)/$(TESTCASE).sv ; })
	$(call run, elaborate, xelab --incr --debug typical --relax --mt 8 -L xil_defaultlib -L uvm -L unisims_ver -L unimacro_ver -L secureip --snapshot $(TESTCASE) work.$(TESTCASE))
	$(call run, simulate, timeout $(TIMEOUT) xsim $(TESTCASE) -runall -onfinish quit)
	@result=$$(grep -m1 FINISH simulate.log | awk '{print $$2}') ;\
	if [ "$$result" = PASS ]; then \
		echo "$(TESTCASE) ........ $(GREEN)PASS$(NC)" ;\
	else \
		echo "$(TESTCASE) ........ $(RED)FAIL$(NC)" ;\
	fi ;\
